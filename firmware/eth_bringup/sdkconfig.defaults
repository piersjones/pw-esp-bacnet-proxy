# W5500 SPI Ethernet bring-up config — pins match requirements.md §3B exactly.
CONFIG_EXAMPLE_USE_INTERNAL_ETHERNET=n
CONFIG_EXAMPLE_USE_SPI_ETHERNET=y
CONFIG_EXAMPLE_USE_W5500=y

CONFIG_EXAMPLE_ETH_SPI_HOST=1
CONFIG_EXAMPLE_ETH_SPI_SCLK_GPIO=18
CONFIG_EXAMPLE_ETH_SPI_MOSI_GPIO=23
CONFIG_EXAMPLE_ETH_SPI_MISO_GPIO=19
CONFIG_EXAMPLE_ETH_SPI_CLOCK_MHZ=12
CONFIG_EXAMPLE_ETH_SPI_CS0_GPIO=5
CONFIG_EXAMPLE_ETH_SPI_INT0_GPIO=4
CONFIG_EXAMPLE_ETH_SPI_PHY_RST0_GPIO=16
